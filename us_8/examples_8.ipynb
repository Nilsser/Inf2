    "def transform_data(data):\n",
    "    data['status'] = 'processed'\n",
    "    data = {'status': 'new', 'value': 42}\n",
    "    data['value'] += 1\n",
    "    return data\n",
    "\n",
    "info = {'status': 'pending', 'value': 10}\n",
    "result = transform_data(info)\n",
    "\n",
    "# Was ist der Wert von info? \n",
    "print(info)"
   ]
